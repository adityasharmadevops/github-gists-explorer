# Send only files that the dependency/test/runtime stages need.
*
!Dockerfile
!requirements.txt
!app.py
!github_client.py
!settings.py
!gunicorn.conf.py
!templates/
!templates/**
!static/
!static/**
!tests/
!tests/**
# Do not copy locally generated bytecode, including inside tests/.
**/__pycache__
**/*.pyc
